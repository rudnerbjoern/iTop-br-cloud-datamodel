          <callback>CheckLoadBalancerCloud</callback>
        </event_listener>
      </event_listeners>
      <methods>
        <method id="CheckLoadBalancerCloud">
          <type>EventListener</type>
          <code><![CDATA[
public function CheckLoadBalancerCloud(Combodo\iTop\Service\Events\EventData $event)
{
    if ($this->GetKey() <= 0 || (int) $this->GetOriginal('cloud_id') === (int) $this->Get('cloud_id')) {
        return;
    }
    $search = DBObjectSearch::FromOQL(
        'SELECT CloudNetworkLoadBalancer WHERE cloud_id != :cloud AND (listener_lan_id = :lan OR backend_lan_id = :lan)'
    );
    $search->AllowAllData();
    $balancers = new DBObjectSet($search, [], ['cloud' => $this->Get('cloud_id'), 'lan' => $this->GetKey()]);
    if ($balancers->Count() > 0) {
        $this->AddCheckIssue(Dict::S('Class:CloudLan/Check:LoadBalancerInCloud'));
    }
}
          ]]></code>
        </method>
