          <callback>CheckLoadBalancerLans</callback>
        </event_listener>
      </event_listeners>
      <methods>
        <method id="CheckLoadBalancerLans">
          <type>EventListener</type>
          <code><![CDATA[
public function CheckLoadBalancerLans(Combodo\iTop\Service\Events\EventData $event)
{
    $cloudId = (int) $this->Get('cloud_id');
    foreach (['listener_lan_id', 'backend_lan_id'] as $role) {
        $lanId = (int) $this->Get($role);
        $lan = $lanId > 0 ? MetaModel::GetObject('CloudLan', $lanId, false, true) : null;
        if ($lan !== null && (int) $lan->Get('cloud_id') !== $cloudId) {
            $this->AddCheckIssue(Dict::S('Class:CloudNetworkLoadBalancer/Check:LansInCloud'));
            return;
        }
    }
}
          ]]></code>
